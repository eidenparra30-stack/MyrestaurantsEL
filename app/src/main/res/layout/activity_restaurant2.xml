<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".restaurant2">

    <!-- Menu Title -->
    <TextView
        android:id="@+id/menuBTN"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pizza Hut Menu"
        android:textColor="@color/red"
        android:textSize="38sp"
        android:textStyle="bold"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Pepperoni Pizza -->
    <ImageView
        android:id="@+id/pepperonipizza"
        android:layout_width="145dp"
        android:layout_height="145dp"
        android:layout_marginTop="60dp"
        android:layout_marginStart="40dp"
        android:scaleType="centerCrop"
        android:src="@drawable/pepperonipizzafeature"
        app:layout_constraintTop_toBottomOf="@id/menuBTN"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Pepperoni Button -->
    <Button
        android:id="@+id/pepperoniBTN"
        android:layout_width="145dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Pepperoni Pizza"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/pepperonipizza"
        app:layout_constraintStart_toStartOf="@id/pepperonipizza"
        app:layout_constraintEnd_toEndOf="@id/pepperonipizza"
        android:backgroundTint="@color/black"
        android:textColor="@color/red"
        android:textSize="17dp"/>


    <!-- Cheese Pizza -->
    <ImageView
        android:id="@+id/cheesepizza"
        android:layout_width="145dp"
        android:layout_height="145dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="40dp"
        android:scaleType="centerCrop"
        android:src="@drawable/cheesepizzafeature"
        app:layout_constraintTop_toBottomOf="@id/menuBTN"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cheese Button -->
    <Button
        android:id="@+id/cheeseBTN"
        android:layout_width="145dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Cheese Pizza"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/cheesepizza"
        app:layout_constraintStart_toStartOf="@id/cheesepizza"
        app:layout_constraintEnd_toEndOf="@id/cheesepizza"
        android:textColor="@color/red"
        android:backgroundTint="@color/black"
        android:textSize="17dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>






