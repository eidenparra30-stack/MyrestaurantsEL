<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".restaurant2">

    <!-- Menu Title -->
    <TextView
        android:id="@+id/menuTitleTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/pizza_hut_menu"
        android:textColor="@color/red"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Pepperoni Pizza Image -->
    <ImageView
        android:id="@+id/pepperonipizza"
        android:layout_width="150dp"
        android:layout_height="145dp"
        android:layout_marginTop="48dp"
        android:contentDescription="@string/pepperoni_pizza"
        android:scaleType="centerCrop"
        android:src="@drawable/pepperonipizzafeature"
        app:layout_constraintEnd_toStartOf="@id/cheesepizza"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menuTitleTV" />

    <!-- Pepperoni Button -->
    <Button
        android:id="@+id/pepperoniBTN"
        android:layout_width="145dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/black"
        android:text="@string/pepperoni_pizza"
        android:textColor="@color/red"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/pepperonipizza"
        app:layout_constraintStart_toStartOf="@id/pepperonipizza"
        app:layout_constraintTop_toBottomOf="@id/pepperonipizza" />

    <!-- Cheese Pizza Image -->
    <ImageView
        android:id="@+id/cheesepizza"
        android:layout_width="150dp"
        android:layout_height="145dp"
        android:contentDescription="@string/cheese_pizza"
        android:scaleType="centerCrop"
        android:src="@drawable/cheesepizzafeature"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/pepperonipizza"
        app:layout_constraintTop_toTopOf="@id/pepperonipizza" />

    <!-- Cheese Button -->
    <Button
        android:id="@+id/cheeseBTN"
        android:layout_width="145dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/black"
        android:text="@string/cheese_pizza"
        android:textColor="@color/red"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/cheesepizza"
        app:layout_constraintStart_toStartOf="@id/cheesepizza"
        app:layout_constraintTop_toBottomOf="@id/cheesepizza" />


    <!-- Pepperoni Sizes -->
    <LinearLayout
        android:id="@+id/pepperoniSizeLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/pepperoniBTN"
        app:layout_constraintStart_toStartOf="@id/pepperoniBTN"
        app:layout_constraintEnd_toEndOf="@id/pepperoniBTN">

        <Button
            android:id="@+id/pepperoniSmallBTN"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:text="S"
            android:textSize="16sp" />

        <Button
            android:id="@+id/pepperoniMediumBTN"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:text="M"
            android:textSize="16sp" />

        <Button
            android:id="@+id/pepperoniLargeBTN"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:text="L"
            android:textSize="16sp" />

    </LinearLayout>


    <!-- Cheese Sizes -->
    <LinearLayout
        android:id="@+id/cheeseSizeLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/cheeseBTN"
        app:layout_constraintStart_toStartOf="@id/cheeseBTN"
        app:layout_constraintEnd_toEndOf="@id/cheeseBTN">

        <Button
            android:id="@+id/cheeseSmallBTN"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:text="S"
            android:textSize="16sp" />

        <Button
            android:id="@+id/cheeseMediumBTN"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:text="M"
            android:textSize="16sp" />

        <Button
            android:id="@+id/cheeseLargeBTN"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:text="L"
            android:textSize="16sp" />

    </LinearLayout>


    <!-- Pepperoni Quantity -->
    <LinearLayout
        android:id="@+id/pepperoniQuantityLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@id/pepperoniBTN"
        app:layout_constraintStart_toStartOf="@id/pepperoniBTN"
        app:layout_constraintTop_toBottomOf="@id/pepperoniSizeLayout">

        <Button
            android:id="@+id/pepperoniMinusBTN"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:text="-"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/pepperoniQuantityTV"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <Button
            android:id="@+id/pepperoniPlusBTN"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:text="+"
            android:textSize="20sp" />

    </LinearLayout>


    <!-- Cheese Quantity -->
    <LinearLayout
        android:id="@+id/cheeseQuantityLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@id/cheeseBTN"
        app:layout_constraintStart_toStartOf="@id/cheeseBTN"
        app:layout_constraintTop_toBottomOf="@id/cheeseSizeLayout">

        <Button
            android:id="@+id/cheeseMinusBTN"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:text="-"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/cheeseQuantityTV"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <Button
            android:id="@+id/cheesePlusBTN"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:text="+"
            android:textSize="20sp" />

    </LinearLayout>


    <!-- Place Order -->
    <Button
        android:id="@+id/placeOrderBTN"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:backgroundTint="@color/black"
        android:text="PLACE ORDER"
        android:textColor="@color/red"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/pepperoniQuantityLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Add To Cart -->
    <Button
        android:id="@+id/addCartBTN"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:backgroundTint="@color/black"
        android:text="ADD TO CART"
        android:textColor="@color/red"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/placeOrderBTN" />


    <!-- Subtotal -->
    <TextView
        android:id="@+id/subtotalTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:text="Subtotal: $0.00"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/placeOrderBTN" />

    <!-- Tax -->
    <TextView
        android:id="@+id/taxTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Tax: $0.00"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtotalTV" />

    <!-- Total -->
    <TextView
        android:id="@+id/totalTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Total: $0.00"
        android:textColor="@color/red"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/taxTV" />

</androidx.constraintlayout.widget.ConstraintLayout>